{
  "name": "sorenb-studio-bookmarks-review",
  "displayName": "Bookmarks Review for UiPath Studio",
  "description": "Adds review notes with formatted text and inline screenshots to UiPath Studio bookmarks, stored in the project's Git repo.",
  "version": "0.2.0",
  "publisher": "sorenbcoding",
  "private": true,
  "license": "MIT",
  "author": "Søren Schytz Birk",
  "homepage": "https://github.com/sorenbcoding/bookmarks-review-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/sorenbcoding/bookmarks-review-studio"
  },
  "bugs": {
    "url": "https://github.com/sorenbcoding/bookmarks-review-studio/issues"
  },
  "icon": "branding/bookmarks-review-studio-light-128.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "uipath",
    "studio",
    "bookmarks",
    "code review",
    "review notes"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "workspaceContains:project.json",
    "workspaceContains:.project/bookmarks.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bookmarksReview",
          "title": "Bookmarks Review",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "bookmarksReview": [
        {
          "type": "webview",
          "id": "bookmarksReview.view",
          "name": "Review notes"
        }
      ]
    },
    "configuration": {
      "title": "Bookmarks Review",
      "properties": {
        "bookmarksReview.hideNotesWithoutBookmark": {
          "type": "boolean",
          "default": false,
          "description": "Hides review notes whose Studio bookmark was deleted. The note files stay in .review/, re-attach if the bookmark is added again, and can be shown again from the panel."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild webview/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/webview.js",
    "test": "node --test test/*.test.js",
    "package": "npm test && npm run build && npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@toast-ui/editor": "3.2.2",
    "esbuild": "0.24.2"
  }
}
