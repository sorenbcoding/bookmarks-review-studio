{
  "name": "bookmarks-review",
  "displayName": "Bookmarks Review",
  "description": "Rich review notes for UiPath Studio bookmarks: formatting and inline screenshots, stored in Git next to the project.",
  "version": "0.2.0",
  "publisher": "bookmarks-review",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Other"],
  "main": "./src/extension.js",
  "activationEvents": [
    "workspaceContains:project.json",
    "workspaceContains:.project/bookmarks.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "bookmarksReview", "title": "Bookmarks Review", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "bookmarksReview": [
        { "type": "webview", "id": "bookmarksReview.view", "name": "Review notes" }
      ]
    }
  },
  "scripts": {
    "build": "esbuild webview/main.js --bundle --minify --format=iife --target=es2020 --outfile=media/main.js",
    "test": "node --test test/",
    "package": "npm test && npm run build && npx --yes @vscode/vsce package --skip-license --allow-missing-repository"
  },
  "devDependencies": {
    "@toast-ui/editor": "3.2.2",
    "esbuild": "0.24.2"
  }
}
